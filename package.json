{
  "name": "pi-skill-latch",
  "version": "0.3.0",
  "description": "Pi package that makes skills cost nothing until they are needed: keyword hints, a search_skills tool, and compression boundary notes when ACP is present.",
  "keywords": [
    "pi-package",
    "pi",
    "skills",
    "context"
  ],
  "author": "cai7199",
  "homepage": "https://github.com/cai7199/pi-skill-latch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cai7199/pi-skill-latch.git"
  },
  "bugs": {
    "url": "https://github.com/cai7199/pi-skill-latch/issues"
  },
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "changelogPath": "./CHANGELOG.md"
  },
  "files": [
    "src",
    "bin",
    "skill-suggest.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test",
    "audit": "node bin/audit-triggers.ts",
    "pack-check": "node scripts/pack-check.mjs",
    "fresh-check": "node scripts/fresh-check.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "typebox": "*"
  },
  "devDependencies": {
    "typebox": "^1.3.27"
  }
}
